PORT=8080
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
JWT_KEY=
JWT_SESSION_KEY=
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_SECRET_KEY=
GOOGLE_USER=
GOOGLE_AUTH_APP_PASSWORD=
IMAGEKIT_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RATE_EXCHANGE=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Managed Redis (Render/Upstash): set REDIS_URL and leave the split vars empty.
REDIS_URL=rediss://<user>:<pass>@<host>:<port>
# Self-hosted Redis alternative (ignored when REDIS_URL is set):
REDIS_HOST=
REDIS_PORT=
REDIS_USER=
REDIS_PASSWORD=
